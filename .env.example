# Copy to `.env` (gitignored) and fill in. Load it before running the CLI or the
# live tests:   set -a; . ./.env; set +a
# See docs/development.md#live-tests for setup and docs/how-to/api-key-scopes.md
# for the scopes each resource needs.

# Open Cloud API key (Creator Dashboard → Credentials). Grant the scopes for the
# resources you manage, *for the test universe*, and save the key. For the full
# live suite, that is:
#   universe:write, universe.place:read, universe.place:write,
#   universe-places:write, universe.secret:read, universe.secret:write,
#   asset:read, asset:write, developer-product:read, developer-product:write,
#   game-pass:read, game-pass:write,
#   legacy-universe.badge:manage-and-spend-robux, legacy-universe.badge:write,
#   legacy-badge:manage
ROBLOX_API_KEY=

# Live tests only run when this is 1.
BASEPLATE_LIVE=1

# A throwaway universe the key can modify. Live tests change its settings and
# create (and clean up) products, passes, badges and secrets in it.
BASEPLATE_TEST_UNIVERSE=

# A place in that universe. The place test publishes to it, and the place-config
# test changes its name, description and server size.
BASEPLATE_TEST_PLACE=

# The Roblox user id that owns the API key (asset uploads are owned by it).
# Required by the asset tests.
BASEPLATE_TEST_USER=
